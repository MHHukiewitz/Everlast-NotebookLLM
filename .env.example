# Local demo. Copy to .env

DEFAULT_TENANT_ID=default
DEFAULT_USER_ID=demo

SESSION_SECRET=change-me-session-secret
SESSION_HTTPS=false
DEMO_EMAIL=
DEMO_PASSWORD=
REGISTER_ALLOWLIST=

DATABASE_URL=postgresql+asyncpg://notebook:notebook@localhost:5433/notebook
REDIS_URL=redis://localhost:6379/0

# Model routes
DEFAULT_PROVIDER=hetzner
DEFAULT_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
OLLAMA_API_BASE=http://localhost:11434

OPENROUTER_API_KEY=
OPENROUTER_MODELS=openrouter/anthropic/claude-sonnet-4.6,openrouter/openai/gpt-5.2,openrouter/google/gemini-2.5-pro,openrouter/openai/gpt-5.6-sol,openrouter/google/gemini-3.7-flash,openrouter/deepseek/deepseek-v4-pro,openrouter/deepseek/deepseek-v4-flash,openrouter/qwen/qwen3-235b-a22b-2507,openrouter/z-ai/glm-5.2

EU_LLM_BASE_URL=
EU_LLM_API_KEY=
EU_LLM_MODELS=

HETZNER_API_BASE=https://inference.hetzner.com/api/v1
HETZNER_API_KEY=
HETZNER_MODELS=Qwen/Qwen3.6-35B-A3B-FP8,Qwen3.8-27B

# Embeddings stay local
EMBEDDING_BACKEND=ollama
EMBEDDING_DIM=768
EMBEDDING_MODEL=nomic-embed-text

# Speech: Piper speaks German locally. Kokoro is English-only.
TTS_LOCAL_BASE_URL=http://127.0.0.1:8880
TTS_LOCAL_MODELS=piper,kokoro
TTS_EU_MODELS=
TTS_OPENROUTER_MODELS=openai/gpt-4o-mini-tts
TTS_VOICE_A=de_DE-thorsten-medium
TTS_VOICE_B=de_DE-kerstin-low
TTS_VOICE_A_EN=alloy
TTS_VOICE_B_EN=nova
TTS_PIPER_VOICE_DIR=./data/tts-voices
DEFAULT_TTS_PROVIDER=local
DEFAULT_TTS_MODEL=piper
IMAGE_LOCAL_BASE_URL=http://127.0.0.1:8081
IMAGE_LOCAL_MODELS=flux
IMAGE_EU_MODELS=
IMAGE_OPENROUTER_MODELS=google/gemini-2.5-flash-image
DEFAULT_IMAGE_PROVIDER=openrouter
DEFAULT_IMAGE_MODEL=google/gemini-2.5-flash-image

SEARXNG_URL=http://localhost:8080
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

FILE_STORE=./data/files
RETENTION_DAYS=30
RESEARCH_SCRATCH_DAYS=30

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_ADDRESS=
NEXT_PUBLIC_OPERATOR_EMAIL=
