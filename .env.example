# Local demo. Copy to .env

DEFAULT_TENANT_ID=default
DEFAULT_USER_ID=demo

SESSION_SECRET=change-me-session-secret
SESSION_HTTPS=false
DEMO_EMAIL=
DEMO_PASSWORD=
REGISTER_ALLOWLIST=

DATABASE_URL=postgresql+asyncpg://notebook:notebook@localhost:5433/notebook
REDIS_URL=redis://localhost:6379/0

# Model routes
DEFAULT_PROVIDER=ollama
DEFAULT_MODEL=llama3.2
OLLAMA_API_BASE=http://localhost:11434

OPENROUTER_API_KEY=
OPENROUTER_MODELS=openrouter/anthropic/claude-sonnet-4.6,openrouter/openai/gpt-5.2,openrouter/google/gemini-2.5-pro

EU_LLM_BASE_URL=
EU_LLM_API_KEY=
EU_LLM_MODELS=

# Embeddings stay local
EMBEDDING_BACKEND=ollama
EMBEDDING_DIM=768
EMBEDDING_MODEL=nomic-embed-text

SEARXNG_URL=http://localhost:8080
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

FILE_STORE=/data/files
RETENTION_DAYS=30
RESEARCH_SCRATCH_DAYS=30

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_ADDRESS=
NEXT_PUBLIC_OPERATOR_EMAIL=
